{
  "name": "kepos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "android": "npm run backend:bundle:android && expo run:android",
    "android:assemble": "npm run backend:bundle:android && expo prebuild --platform android --no-install && cd android && ./gradlew assembleDebug",
    "backend:bundle:android": "bare-pack --host android-arm64 --linked --out mobile/app.bundle.mjs backend/backend.mjs",
    "mobile:prebuild:android": "expo prebuild --platform android",
    "mobile:start": "npm run backend:bundle:android && expo start",
    "start": "node src/cli.js",
    "test": "node --test"
  },
  "dependencies": {
    "autobase": "^7.28.1",
    "b4a": "^1.8.1",
    "bare-os": "^3.9.1",
    "bare-rpc": "^1.3.3",
    "corestore": "^7.10.1",
    "expo": "~56.0.12",
    "expo-build-properties": "^56.0.19",
    "hypercore-crypto": "^3.7.0",
    "hyperswarm": "^4.17.0",
    "lucide-react-native": "^1.18.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-bare-kit": "^0.14.3",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "bare-pack": "^2.1.3"
  }
}
