{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "tmp/bare-bundle-js",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "backend/**/*.mjs",
    "rpc-commands.mjs",
    "scripts/probe-typescript.ts",
    "src/**/*.js",
    "src/**/*.ts"
  ]
}
