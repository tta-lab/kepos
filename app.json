{
  "expo": {
    "name": "Kepos",
    "slug": "kepos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "kepos",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ]
    ],
    "android": {
      "package": "io.guion.kepos",
      "permissions": ["INTERNET"]
    }
  }
}
